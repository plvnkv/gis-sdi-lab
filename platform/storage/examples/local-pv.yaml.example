apiVersion: v1
kind: PersistentVolume
metadata:
  name: gis-postgis-data
  annotations:
    argocd.argoproj.io/sync-options: Prune=false,Delete=false
spec:
  capacity:
    storage: 50Gi
  accessModes:
    - ReadWriteOnce
  volumeMode: Filesystem
  storageClassName: gis-local
  persistentVolumeReclaimPolicy: Retain
  claimRef:
    namespace: gis
    name: postgis-data
  local:
    path: /srv/gis/REPLACE_WITH_MOUNT/postgis
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - key: kubernetes.io/hostname
              operator: In
              values:
                - REPLACE_WITH_NODE_LABEL
